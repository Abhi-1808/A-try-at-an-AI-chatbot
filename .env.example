# Documentation only; the application reads process environment, not this file.
# Leave keys out of source control. Mock mode needs none of these settings.
ANTHROPIC_API_KEY=
HOPE_ANTHROPIC_MODEL=
# For models accepting disabled. Sonnet 5.5 requires between_tools (no tools yet).
HOPE_ANTHROPIC_THINKING_MODE=disabled
HOPE_MAX_TOKENS=256
HOPE_TIMEOUT_SECONDS=30
HOPE_TURN_BUDGET_USD=0.01
HOPE_SESSION_BUDGET_USD=0.05
# Enter current prices for your chosen model; there are no default prices.
HOPE_INPUT_USD_PER_MILLION=
HOPE_OUTPUT_USD_PER_MILLION=

# Optional local AI (no API key). Requires an already downloaded Ollama model.
HOPE_OLLAMA_MODEL=qwen3:4b
HOPE_OLLAMA_PORT=11434
HOPE_OLLAMA_MAX_TOKENS=768
HOPE_OLLAMA_TIMEOUT_SECONDS=180
